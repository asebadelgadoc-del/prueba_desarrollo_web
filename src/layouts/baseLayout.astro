---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { title = "ESPACIO CULTURAL" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Página creada con Astro" />
    <title>{title}</title>
  </head>

  <body>
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
