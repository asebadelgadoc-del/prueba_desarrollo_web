---
import BaseLayout from "../layouts/baselayout.astro";
import Card from "../components/Card.astro";

const servicios = [
{
titulo: "Fotografía",
descripcion: "Aprende a capturar momentos y expresar tu creatividad a través de imágenes.",
imagen: "/placeholder.svg",
},
{
titulo: "Cerámica",
descripcion: "Crea figuras y objetos utilizando diferentes técnicas de modelado con arcilla.",
imagen: "/placeholder.svg",
},
{
titulo: "Escritura creativa",
descripcion: "Desarrolla tu imaginación creando cuentos, poemas e historias originales.",
imagen: "/placeholder.svg",
},
{
titulo: "Ilustración",
descripcion: "Aprende a dibujar y crear ilustraciones utilizando distintas técnicas artísticas.",
imagen: "/placeholder.svg",
},
];

---

<BaseLayout title="Inicio">
  <section>
    <h1>Bienvenido a mi proyecto</h1>
    <p>Esta es la página principal de nuestro sitio web.</p>
  </section>

  <section>
    <h2>Nuestros servicios</h2>

    {servicios.map((servicio) => (
      <Card
        nombre={servicio.titulo}
        descripcion={servicio.descripcion}
        imagen={servicio.imagen}
      />
    ))}
  </section>
</BaseLayout>
