
---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Car from "../components/Card.astro";
import "../styles/global.css";
import BaseLayout from "../layouts/baselayout.astro";
import foto from "../assets/images.jpg";

const talleres = [
  {
    nombre: "Fotografia",
    imagen: "/assets/images.jpg",
    descripcion:
      "Introduccion a la composicion y técnicas de fotografia digital."
  },
  {
    nombre: "Ceramica",
    imagen: "/images/images2.jpg",
    descripcion:
      "Creacion de objetos utilizando técnicas basicas de modelado."
  },
  {
    nombre: "Escritura creativa",
    imagen: "/images/images3.jpg",
    descripcion:
      "Exploracion de relatos breves y ejercicios de escritura."
  },
  {
    nombre: "Ilustracion",
    imagen: "/images/images4.jpg",
    descripcion:
      "Desarrollo de habilidades de dibujo e ilustracion digital."
  }
];
---

<Navbar />

<main>
  <h1>Nuestros talleres</h1>

  <p>
    En Espacio Cultural promovemos la creatividad y la expresión artística
    mediante talleres donde puedes aprender nuevas técnicas, desarrollar
    tus habilidades y compartir tus ideas.
  </p>

  <section>
    <h2>Descubre nuestros talleres</h2>

    <div>
      {talleres.map((taller) => (
        <Car
          nombre={taller.nombre}
          imagen={taller.imagen}
          descripcion={taller.descripcion}
        />
      ))}
    </div>
  </section>
</main>

<Footer />

